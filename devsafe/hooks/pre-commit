#!/bin/sh
# Installed by DevSafe (`devsafe init`). Do not edit; re-run `devsafe init` instead.
#
# The profile check itself lives in the devsafe package, so upgrading DevSafe
# updates it for every repository. `devsafe init` fills in the Python it was
# run with, which also works in GUI git clients whose PATH lacks `devsafe`.

DEVSAFE_PYTHON=__DEVSAFE_PYTHON__

if [ -x "$DEVSAFE_PYTHON" ]; then
    exec "$DEVSAFE_PYTHON" -m devsafe hook pre-commit
fi

if command -v devsafe >/dev/null 2>&1; then
    exec devsafe hook pre-commit
fi

echo "⚠️  DevSafe not found; skipping profile check. Reinstall DevSafe or re-run 'devsafe init'." >&2
exit 0
